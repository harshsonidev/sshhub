{
  "name": "sshhub",
  "productName": "SSHHub",
  "version": "0.1.0",
  "description": "Cross-platform local SSH profile manager",
  "author": {
    "name": "Harsh Soni",
    "email": "harshsoni.dev@gmail.com"
  },
  "main": "dist/main/main/index.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build renderer",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "concurrently -k \"vite renderer\" \"npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^26.15.7",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.sshhub.app",
    "productName": "SSHHub",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
